{
	"name": "@apps/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./composition": {
			"types": "./dist/composition.d.ts",
			"default": "./dist/composition.js"
		}
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"prebuild": "pnpm run lint",
		"build": "tsgo --build && tsgo --noEmit --project tsconfig.rolldown.json && rolldown -c rolldown.config.ts && cellix-prepare-func-deploy && node scripts/zip-deploy.mjs",
		"dev": "pnpm exec portless api.agentcourses.localhost --force node start-dev.ts",
		"dev:worktree": "pnpm exec portless api.agentcourses.${WORKTREE_NAME}.localhost --force node start-dev.ts",
		"watch": "tsgo --watch",
		"test": "vitest run --silent --reporter=dot",
		"test:arch": "vitest run --config vitest.arch.config.ts",
		"test:watch": "vitest",
		"clean": "rimraf dist deploy",
		"start": "node start-local-runtime.ts"
	},
	"dependencies": {
		"@axc/application-services": "workspace:*",
		"@axc/domain": "workspace:*",
		"@axc/rest": "workspace:*",
		"@axc/service-mongoose": "workspace:*",
		"@azure/functions": "catalog:",
		"@hono/node-server": "^1.19.0",
		"@marplex/hono-azurefunc-adapter": "^1.0.0",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@cellix/config-rolldown": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"@cellix/local-dev": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"archunit": "catalog:",
		"rimraf": "catalog:",
		"rolldown": "1.2.8",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
